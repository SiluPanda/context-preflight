{
  "name": "context-preflight",
  "version": "0.1.0",
  "description": "Zero-dependency preflight CI linter & GitHub Action for AI agent context layers (CLAUDE.md, AGENTS.md, SKILL.md, .mcp.json, MCP schemas, and prompt caches).",
  "type": "module",
  "bin": {
    "context-preflight": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node --input-type=commonjs -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "model-context-protocol",
    "agents-md",
    "claude-md",
    "skill-md",
    "prompt-caching",
    "ai-agents",
    "linter",
    "github-action",
    "sarif",
    "cli"
  ],
  "author": "Silu Panda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiluPanda/context-preflight.git"
  },
  "bugs": {
    "url": "https://github.com/SiluPanda/context-preflight/issues"
  },
  "homepage": "https://github.com/SiluPanda/context-preflight#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
